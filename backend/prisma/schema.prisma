generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  username      String?        @unique
  email         String         @unique
  phone         String?
  role          UserRole       @default(RUNNER)
  avatarUrl     String?
  referralCode  String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  clerkId       String?        @unique
  registrations Registration[]
  referralsMade Referral[]     @relation("referrals_made")
}

model Event {
  id               String         @id @default(cuid())
  title            String
  slug             String         @unique
  description      String
  status           EventStatus    @default(DRAFT)
  startsAt         DateTime
  endsAt           DateTime
  proofClosesAt    DateTime
  distances        String[]
  priceInPaise     Int
  paymentRequired  Boolean        @default(true)
  medalIncluded    Boolean        @default(true)
  featured         Boolean        @default(false)
  maxCapacity      Int?
  city             String?
  bannerImageUrl   String?
  couponCode       String?
  showCouponOnCard Boolean      @default(false)
  activityTypes    String[]     @default(["running"])
  benefits         String[]
  finishers        Int?
  verifiedResults  Int?
  cities           Int?
  resultNote       String?
  banner           String?
  reward           String?
  highlight        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  registrations    Registration[]
}

model Registration {
  id                String             @id @default(cuid())
  bibNumber         String             @unique
  userId            String
  eventId           String
  distance          String
  activityType      String             @default("running")
  status            RegistrationStatus @default(PENDING_PAYMENT)
  proofStatus       ProofStatus        @default(NOT_SUBMITTED)
  registeredAt      DateTime           @default(now())
  finishTimeSeconds Int?
  shippingName      String
  shippingPhone     String
  shippingLine1     String
  shippingLine2     String?
  shippingCity      String
  shippingState     String
  shippingPincode   String
  adminNote         String?
  certificate       Certificate?
  medalDelivery     MedalDelivery?
  payment           Payment?
  proofUpload       ProofUpload?
  event             Event              @relation(fields: [eventId], references: [id])
  user              User               @relation(fields: [userId], references: [id])

  @@unique([userId, eventId, distance])
  @@index([eventId, proofStatus])
  @@index([eventId, finishTimeSeconds])
  @@index([status])
  @@index([registeredAt])
}

model Payment {
  id                String        @id @default(cuid())
  registrationId    String        @unique
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  razorpaySignature String?
  amountInPaise     Int
  status            PaymentStatus @default(CREATED)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  registration      Registration  @relation(fields: [registrationId], references: [id])
}

model ProofUpload {
  id               String       @id @default(cuid())
  registrationId   String       @unique
  activityImageUrl String
  sourceApp        String
  submittedAt      DateTime     @default(now())
  reviewedAt       DateTime?
  reviewerNote     String?
  status           ProofStatus  @default(SUBMITTED)
  registration     Registration @relation(fields: [registrationId], references: [id])
}

model Certificate {
  id                String            @id @default(cuid())
  registrationId    String            @unique
  certificateNumber String            @unique
  pdfUrl            String?
  qrPayload         String
  status            CertificateStatus @default(QUEUED)
  issuedAt          DateTime?
  registration      Registration      @relation(fields: [registrationId], references: [id])
}

model MedalDelivery {
  id             String       @id @default(cuid())
  registrationId String       @unique
  courier        String?
  trackingNumber String?
  trackingUrl    String?
  status         MedalStatus  @default(PENDING)
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  registration   Registration @relation(fields: [registrationId], references: [id])
}

model Subscriber {
  id         String   @id @default(cuid())
  email      String   @unique
  subscribed Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Referral {
  id         String   @id @default(cuid())
  referrerId String
  refereeId  String   @unique
  code       String
  status     String   @default("pending")
  rewardGiven Boolean  @default(false)
  createdAt  DateTime @default(now())

  referrer User @relation("referrals_made", fields: [referrerId], references: [id])

  @@index([referrerId])
  @@index([code])
  @@map("referrals")
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discountPaise  Int
  maxRedemptions Int?
  redeemedCount  Int       @default(0)
  expiresAt      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String?
  channel   String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  actorClerkId String?
  actorEmail   String?
  action       String
  entityType   String
  entityId     String?
  summary      String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

/** Admin-managed photo for gallery + homepage “Moments of glory”. */
model SiteMedia {
  id                String   @id @default(cuid())
  title             String
  imageUrl          String
  category          String   @default("Community")
  location          String?
  eventLabel        String?
  dateLabel         String?
  meta              String?
  submittedBy       String?
  sortOrder         Int      @default(0)
  published         Boolean  @default(true)
  showInGallery     Boolean  @default(true)
  showOnHomeMoments Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([published, showInGallery])
  @@index([published, showOnHomeMoments])
  @@index([sortOrder])
}

/** Admin-managed community reviews for homepage. */
model SiteTestimonial {
  id         String   @id @default(cuid())
  name       String
  role       String
  city       String?
  quote      String
  rating     Int      @default(5)
  sortOrder  Int      @default(0)
  published  Boolean  @default(true)
  showOnHome Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, showOnHome])
  @@index([sortOrder])
}

enum UserRole {
  RUNNER
  ADMIN
  SUPER_ADMIN
}

enum EventStatus {
  DRAFT
  OPEN
  CLOSED
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum ProofStatus {
  NOT_SUBMITTED
  SUBMITTED
  APPROVED
  REJECTED
}

enum CertificateStatus {
  QUEUED
  GENERATED
  SENT
}

enum MedalStatus {
  NOT_ELIGIBLE
  PENDING
  DISPATCHED
  DELIVERED
  RETURNED
}
